@startuml diagramme-classes
title Alerte Disparition - Diagramme de classes

hide empty members
skinparam classAttributeIconSize 0
skinparam linetype ortho

' ---------- Comptes ----------

class Utilisateur {
  - id : int
  - nom : string
  - prenom : string
  - telephone : string
  - email : string
  - motDePasse : string
  - role : Role
  - actif : bool
  - dateInscription : datetime
  + sInscrire()
  + seConnecter()
  + modifierProfil()
  + desactiverCompte()
}

enum Role {
  DECLARANT
  MODERATEUR
  ADMIN
}

' ---------- Localisation ----------

class Region {
  - id : int
  - nom : string
}

class Ville {
  - id : int
  - nom : string
}

class Quartier {
  - id : int
  - nom : string
  - arrondissement : string
}

' ---------- Dossiers ----------

abstract class Dossier {
  - id : int
  - reference : string
  - slug : string
  - description : text
  - dateFaits : datetime
  - lieuPrecis : string
  - statut : StatutDossier
  - masque : bool
  - dateSoumission : datetime
  - datePublication : datetime
  + soumettre()
  - version : int
  + transitionner(cible, auteur, motif)
  + masquer(motif)
  + estVisiblePubliquement() : bool
  + lienPublic() : string
}

class DossierPersonne {
  - nomComplet : string
  - sexe : string
  - age : int
  - descriptionPhysique : text
  - signesDistinctifs : text
  - circonstances : text
  + estMineur() : bool
}

class DossierObjet {
  - nature : NatureObjet
  - marque : string
  - modele : string
  - couleur : string
  - signesDistinctifs : text
}

enum NatureObjet {
  PERDU
  TROUVE
}

enum StatutDossier {
  EN_ATTENTE
  PUBLIE
  EN_VERIFICATION
  RESOLU
  REJETE
}

class Categorie {
  - id : int
  - libelle : string
  - sensible : bool
}

class Photo {
  - id : int
  - chemin : string
  - publique : bool
}

class HistoriqueStatut {
  - id : int
  - ancienStatut : StatutDossier
  - nouveauStatut : StatutDossier
  - motif : text
  - date : datetime
}

' ---------- Temoignages ----------
' Decision du groupe : pas besoin de compte pour temoigner,
' on garde juste un moyen de recontacter le temoin.

class Temoignage {
  - id : int
  - type : TypeTemoignage
  - dateFaits : datetime
  - lieuPrecis : string
  - description : text
  - pieceJointe : string
  - nomTemoin : string
  - telephoneTemoin : string
  - anonyme : bool
  - statut : StatutTemoignage
  - dateSoumission : datetime
}

enum TypeTemoignage {
  APERCU
  INFORMATION
}

enum StatutTemoignage {
  EN_ATTENTE
  PUBLIE
  REJETE
  MASQUE
}

class AccesIdentite {
  - id : int
  - motif : string
  - date : datetime
}

' ---------- Objets : rapprochement ----------

class Correspondance {
  - id : int
  - score : int
  - raisons : string
  - statut : StatutCorrespondance
  - dateDetection : datetime
  + valider()
  + ecarter()
}

enum StatutCorrespondance {
  A_EXAMINER
  VALIDEE
  ECARTEE
}

' ---------- Alertes ----------

class AbonnementAlerte {
  - id : int
  - actif : bool
  - dateCreation : datetime
}

class Notification {
  - id : int
  - type : TypeNotification
  - titre : string
  - message : string
  - lien : string
  - lue : bool
  - dateCreation : datetime
}

enum TypeNotification {
  NOUVELLE_DISPARITION
  TEMOIGNAGE_PUBLIE
  STATUT_DOSSIER
  CORRESPONDANCE
}

interface CanalNotification {
  + envoyer(n : Notification)
}

class Session {
  - empreinteToken : string
  - dateCreation : datetime
  - dateExpiration : datetime
}

' ================= Relations =================

Utilisateur --> Role

Region "1" *-- "1..*" Ville
Ville "1" *-- "1..*" Quartier

Dossier <|-- DossierPersonne
Dossier <|-- DossierObjet
Dossier --> StatutDossier
DossierObjet --> NatureObjet

Utilisateur "1" -- "0..*" Dossier : declare >
Utilisateur "0..1" -- "0..*" Dossier : modere >
Dossier "0..*" -- "1" Quartier : localise dans >
DossierObjet "0..*" -- "1" Categorie
Dossier "1" *-- "0..*" Photo
Dossier "1" *-- "0..*" HistoriqueStatut
HistoriqueStatut "0..*" -- "1" Utilisateur : auteur >

Dossier "1" *-- "0..*" Temoignage
Temoignage --> TypeTemoignage
Temoignage --> StatutTemoignage
Temoignage "0..*" -- "0..1" Quartier : observe a >
Temoignage "0..*" -- "0..1" Utilisateur : valide par >
AccesIdentite "0..*" -- "1" Temoignage
AccesIdentite "0..*" -- "1" Utilisateur : consulte par >


Correspondance "0..*" -- "1" DossierObjet : objet perdu >
Correspondance "0..*" -- "1" DossierObjet : objet trouve >
Correspondance "0..*" -- "0..1" Utilisateur : traitee par >

Utilisateur "1" *-- "0..*" AbonnementAlerte
AbonnementAlerte "0..*" -- "1" Quartier : surveille >
Utilisateur "1" -- "0..*" Notification : recoit >
Notification --> TypeNotification
CanalNotification ..> Notification : diffuse
Correspondance --> StatutCorrespondance
Utilisateur "1" *-- "0..*" Session

@enduml
